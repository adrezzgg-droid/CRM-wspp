rules_version = '2';

// Los adjuntos de WhatsApp solo los lee y escribe el servidor (Admin SDK).
// El navegador los recibe a través de /api/conversations/.../media, que
// verifica sesión y alcance antes de entregar el archivo.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
