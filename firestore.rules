rules_version = '2';

// Reglas de seguridad de Firestore.
//
// Principios:
//  1. Aislamiento por organización: el token (custom claims) trae orgId y role,
//     y solo se puede leer dentro de la propia organización.
//  2. El cliente es SOLO LECTURA. Toda escritura pasa por la API del servidor
//     (Admin SDK), que valida datos, aplica permisos y registra auditoría.
//  3. Mínimo privilegio: el navegador solo lee lo que usa en tiempo real
//     (bandeja: conversaciones, mensajes y el lead; y sus notificaciones). Todo
//     lo demás le llega filtrado por el servidor, así que acá se niega.
//  4. El alcance de la bandeja (todo / equipo / propio) sale de la ficha del
//     usuario (`inboxScope` y `scopeUids`), que el servidor recalcula cuando
//     cambian roles, permisos o equipos (src/server/members/scope-core.ts).
//     Así las reglas respetan los permisos personalizados por empresa y un
//     usuario dado de baja deja de leer aunque su token siga vigente.
//  5. Los secretos, colas internas y eventos de webhook nunca se leen ni
//     escriben desde el cliente.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function inOrg(orgId) { return signedIn() && request.auth.token.orgId == orgId; }

    function me(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data;
    }

    // ¿Puede ver en la bandeja algo cuyo responsable es `owner`? (null = sin asignar)
    function inboxSees(orgId, owner) {
      let m = me(orgId);
      let scope = m.get('inboxScope', '');
      return m.get('active', false) == true && (
        scope == 'todo'
        || (scope == 'equipo' && (owner == null || owner in m.get('scopeUids', [])))
        || (scope == 'propio' && owner == request.auth.uid)
      );
    }

    // Todo lo no declarado queda denegado (clientes, pedidos, notas, auditoría…).
    match /{document=**} { allow read, write: if false; }

    match /organizations/{orgId} {
      match /conversations/{id} {
        // OJO: `resource.data.assigneeId` directo, NO `.get('assigneeId', null)`. En una
        // consulta sin filtro el motor usa el valor por defecto (null = "sin asignar")
        // y la dejaría pasar entera. assigneeId siempre existe (null si no tiene dueño).
        allow read: if inOrg(orgId) && inboxSees(orgId, resource.data.assigneeId);
        allow write: if false;

        match /messages/{messageId} {
          // Hereda el alcance de la conversación padre.
          allow read: if inOrg(orgId) && inboxSees(orgId,
            get(/databases/$(database)/documents/organizations/$(orgId)/conversations/$(id)).data.get('assigneeId', null));
          allow write: if false;
        }
      }

      // El recorrido del lead se muestra en el panel de la conversación: se lee de a uno
      // (ownerId puede faltar, así que una consulta por lista no se podría acotar).
      match /leads/{id} {
        allow get: if inOrg(orgId) && inboxSees(orgId, resource.data.get('ownerId', null));
        allow list: if false;
        allow write: if false;
      }

      match /notifications/{id} {
        allow read: if inOrg(orgId) && resource.data.userId == request.auth.uid;
        // El usuario solo puede marcar como leída su propia notificación.
        allow update: if inOrg(orgId)
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }
    }
  }
}
