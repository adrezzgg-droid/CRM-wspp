# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno del CRM. Copiá este archivo a .env.local y completalo.
# Las variables NEXT_PUBLIC_* llegan al navegador: NUNCA pongas secretos ahí.
# ─────────────────────────────────────────────────────────────────────────────

# Nombre visible del producto
NEXT_PUBLIC_APP_NAME="CRM WhatsApp"

# URL pública de la app (se usa para validar el origen de las peticiones y para
# armar la URL del webhook de WhatsApp). En local: http://localhost:3000
APP_URL=http://localhost:3000

# ── Firebase (cliente, públicas) ─────────────────────────────────────────────
# Firebase Console → Configuración del proyecto → Tus apps → App web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# true => el navegador usa los emuladores locales de Auth y Firestore
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# ── Firebase Admin SDK (servidor, SECRETAS) ──────────────────────────────────
# Firebase Console → Configuración → Cuentas de servicio → Generar clave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pegar la clave entre comillas, con los \n tal cual vienen en el JSON
FIREBASE_PRIVATE_KEY=

# Bucket de Storage para adjuntos de WhatsApp (Firebase Console → Storage)
FIREBASE_STORAGE_BUCKET=

# Solo en desarrollo con emuladores (dejar vacías en producción)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ── Seguridad ────────────────────────────────────────────────────────────────
# Clave AES-256-GCM para cifrar el Access Token de WhatsApp en Firestore.
# 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=

# Duración de la sesión en días (cookie httpOnly; máximo 14 por Firebase)
SESSION_DAYS=5

# ── WhatsApp Cloud API (Fase 9) ──────────────────────────────────────────────
# App Secret de la app de Meta: valida la firma X-Hub-Signature-256 del webhook
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v23.0

# ── Tareas programadas ───────────────────────────────────────────────────────
# Secreto que deben enviar los cron jobs (Authorization: Bearer ...).
# Vercel Cron lo envía solo si la variable existe. Generar uno largo y aleatorio.
CRON_SECRET=
